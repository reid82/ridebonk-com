---
import { APP } from "../data/app";

const discordUrl = "https://discord.gg/pbcbxBxr";
const email = "reid@reidbates.com";
---
<aside class="subscribe-card">
  <h2>Want to try it?</h2>
  <p>
    It&apos;s on the App Store. Free, iPhone, iOS 15 and up. Android
    coming. I still push builds most days, so it changes under you.
  </p>
  <p class="cta-line">
    <a
      class="store-badge"
      href={APP.storeUrl}
      rel="noopener"
      target="_blank"
    >
      <img
        src="/download-on-the-app-store.svg"
        alt={`Download ${APP.name} on the App Store`}
        width="120"
        height="40"
      />
    </a>
  </p>
  <p class="contact-line">
    Questions, comments, requests, abuse:
    <a href={`mailto:${email}`}>{email}</a>
    or come find me on
    <a href={discordUrl} rel="noopener" target="_blank">Discord</a>.
  </p>
</aside>

<style>
  .cta-line {
    margin: 1.1rem 0 0;
  }
  /* Apple's guidelines: don't alter the artwork, keep clear space of
     at least 10% of the badge height, min height 40px. The padding is
     the clear space; the shadow sits on the wrapper, never the badge. */
  .store-badge {
    display: inline-block;
    padding: 4px;
    background: color-mix(in srgb, var(--color-paper) 50%, white 50%);
    border: 1.5px solid var(--color-ink);
    box-shadow: 3px 3px 0 var(--color-ink);
    line-height: 0;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .store-badge img {
    display: block;
    height: 40px;
    width: auto;
  }
  .store-badge:hover,
  .store-badge:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--color-ink);
    outline: none;
  }
  .store-badge:active {
    transform: translate(1px, 1px);
    box-shadow: 2px 2px 0 var(--color-ink);
  }
  .contact-line {
    margin: 1.1rem 0 0;
    font-size: 0.95rem;
    opacity: 0.8;
  }
  .contact-line a {
    font-weight: 600;
    white-space: nowrap;
  }
</style>
